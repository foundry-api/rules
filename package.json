{
	"name": "@foundry-api/rules",
	"version": "0.1.0",
	"description": "Central rules and policies for Foundry Api",
	"license": "MIT",
	"type": "commonjs",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"require": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"AGENTS.md",
		"CONTRIBUTING.md",
		"CHANGELOG.md",
		"docs",
		"skills",
		"templates"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json && node scripts/copy-dts.mjs",
		"clean": "rm -rf dist",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"prepack": "npm run build",
		"prepare": "husky",
		"test:coverage": "c8 --check-coverage --lines 90 --functions 90 --branches 90 --statements 90 npm test",
		"test": "TS_NODE_TRANSPILE_ONLY=1 node --require ts-node/register/transpile-only --test tests/**/*.test.ts",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"verify": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage",
		"yalc:publish": "yalc publish",
		"yalc:push": "yalc push",
		"yalc:remove": "yalc remove",
		"sync:rules": "node scripts/sync-rules.cjs"
	},
	"devDependencies": {
		"@eslint/js": "^9.29.0",
		"@types/node": "^22.0.0",
		"c8": "^10.1.3",
		"eslint": "^9.29.0",
		"globals": "^16.2.0",
		"husky": "^9.1.7",
		"prettier": "^3.0.0",
		"ts-node": "^10.9.2",
		"typescript": "^6.0.0",
		"typescript-eslint": "^8.34.1",
		"yalc": "^1.0.0-pre.53"
	}
}
